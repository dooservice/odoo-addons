<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="category_assistant" model="ir.module.category">
        <field name="name">Dooservice Assistant</field>
        <field name="sequence">90</field>
        <field name="parent_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_ask" model="res.groups">
        <field name="name">Ask</field>
        <field name="comment">Chat with Dooservice about how the company works in Odoo.</field>
        <field name="category_id" ref="category_assistant"/>
    </record>
    <record id="group_request" model="res.groups">
        <field name="name">Request changes</field>
        <field name="comment">Also request new views, boards and reports, and follow them.</field>
        <field name="category_id" ref="category_assistant"/>
        <field name="implied_ids" eval="[Command.link(ref('group_ask'))]"/>
        <field name="users" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>
</odoo>
