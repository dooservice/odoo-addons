<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_assistant" model="res.groups.privilege">
        <field name="name">Dooservice</field>
        <field name="sequence">90</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_ask" model="res.groups">
        <field name="name">Ask and report</field>
        <field name="sequence">10</field>
        <field name="comment">Open questions and incidents to Dooservice, and follow them in Discuss.</field>
        <field name="privilege_id" ref="privilege_assistant"/>
    </record>
    <record id="group_request" model="res.groups">
        <field name="name">Request changes</field>
        <field name="sequence">20</field>
        <field name="comment">Also ask for changes in how Odoo works, rehearsed and approved before they are applied.</field>
        <field name="privilege_id" ref="privilege_assistant"/>
        <field name="implied_ids" eval="[Command.link(ref('group_ask'))]"/>
    </record>
    <record id="group_responsible" model="res.groups">
        <field name="name">Dooservice responsible</field>
        <field name="sequence">30</field>
        <field name="comment">Approves the changes asked by people who may only ask, and sees the team's tickets.</field>
        <field name="privilege_id" ref="privilege_assistant"/>
        <field name="implied_ids" eval="[Command.link(ref('group_request'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>
</odoo>
