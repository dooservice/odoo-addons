<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_ticket_own" model="ir.rule">
        <field name="name">Dooservice tickets: one's own</field>
        <field name="model_id" ref="model_dooservice_ticket"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_ask'))]"/>
    </record>
    <record id="rule_ticket_responsible" model="ir.rule">
        <field name="name">Dooservice tickets: the team's, for the responsible</field>
        <field name="model_id" ref="model_dooservice_ticket"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_responsible')), Command.link(ref('base.group_system'))]"/>
    </record>
</odoo>
