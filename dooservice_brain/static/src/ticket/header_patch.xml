<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.DiscussContent" t-inherit-mode="extension">
        <xpath expr="//AutoresizeInput[@onValidate.bind='renameThread']" position="after">
            <TicketBadge thread="thread"/>
        </xpath>
    </t>

    <t t-inherit="mail.ChatWindow.headerContent" t-inherit-mode="extension">
        <xpath expr="//div[@t-esc='props.chatWindow.displayName']" position="after">
            <TicketBadge t-if="thread" thread="thread" small="true"/>
        </xpath>
    </t>
</templates>
