<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Message" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Message-content')]" position="inside">
            <DooserviceCards message="this.props.message"/>
        </xpath>
    </t>

    <t t-name="dooservice_brain.Cards">
        <div t-if="this.state.payload" class="o-dooservice-cards d-flex flex-column gap-2 mt-2">
            <t t-foreach="this.state.payload.cards" t-as="card" t-key="card.id">
                <t t-set="done" t-value="this.done(card)"/>
                <div t-if="card.type === 'sources'" class="d-flex flex-wrap gap-1 small">
                    <span t-foreach="card.items or []" t-as="item" t-key="item_index" class="badge text-bg-light border" t-out="item"/>
                </div>
                <div t-elif="card.type === 'meta'" class="small text-muted" t-out="card.text"/>
                <div t-else="" class="o-dooservice-card">
                    <div t-if="card.title" class="fw-bold mb-1" t-out="card.title"/>
                    <div t-if="card.text" class="small" t-out="card.text"/>
                    <div t-if="(card.items or []).length" class="d-flex flex-wrap gap-1 my-1">
                        <span t-foreach="card.items" t-as="item" t-key="item_index" class="badge text-bg-light border" t-out="item"/>
                    </div>
                    <div t-if="card.footer" class="small text-muted" t-out="card.footer"/>
                    <t t-if="card.type === 'continue'">
                        <button class="btn btn-sm btn-primary mt-1" t-on-click="() => this.continueFrom(card)">Open a new linked ticket</button>
                    </t>
                    <t t-elif="done.done">
                        <div class="small text-muted mt-1"><i class="fa fa-check me-1"/><t t-out="this.chosen(card)"/><t t-if="done.value">: <t t-out="done.value"/></t></div>
                    </t>
                    <t t-elif="this.actionable(card)">
                        <div class="o-dooservice-buttons d-flex flex-wrap gap-1 mt-2">
                            <button t-foreach="this.options(card)" t-as="option" t-key="option.value" class="btn btn-sm" t-att-class="option_first ? 'btn-primary' : 'btn-outline-primary'" t-att-disabled="this.state.busy" t-on-click="() => this.press(card, option)" t-out="option.label"/>
                        </div>
                        <div t-if="this.state.correcting[card.id]" class="d-flex flex-column gap-1 mt-1">
                            <textarea class="form-control form-control-sm" rows="2" t-att-value="this.state.typed[card.id] or ''" t-on-input="(ev) => this.state.typed[card.id] = ev.target.value" placeholder="What should change?"/>
                        </div>
                    </t>
                    <div t-elif="card.type === 'approval'" class="small text-muted mt-1">Waiting for a Dooservice responsible.</div>
                </div>
            </t>
        </div>
    </t>
</templates>
