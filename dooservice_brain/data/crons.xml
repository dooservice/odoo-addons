<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_sync_tickets" model="ir.cron">
        <field name="name">Dooservice: sync tickets</field>
        <field name="model_id" ref="model_dooservice_ticket"/>
        <field name="state">code</field>
        <field name="code">model._sync_open()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
