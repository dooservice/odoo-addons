<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_answer_questions" model="ir.cron">
        <field name="name">Dooservice Assistant: answer questions</field>
        <field name="model_id" ref="model_dooservice_brain_question"/>
        <field name="state">code</field>
        <field name="code">model._answer_pending()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_follow_requests" model="ir.cron">
        <field name="name">Dooservice Assistant: follow requests</field>
        <field name="model_id" ref="model_dooservice_brain_request"/>
        <field name="state">code</field>
        <field name="code">model._follow_open()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
